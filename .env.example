# ANTHROPIC_API_KEY (用于快速通道的 AI 调用)
ANTHROPIC_API_KEY=sk-ant-...

# GITHUB_APP_ID (GitHub App ID)
GITHUB_APP_ID=123456

# GITHUB_APP_PRIVATE_KEY (GitHub App 私钥路径或内容)
GITHUB_APP_PRIVATE_KEY=/path/to/private-key.pem

# GITHUB_INSTALLATION_ID (GitHub App 安装 ID)
GITHUB_INSTALLATION_ID=12345678

# WEBHOOK_SECRET (GitHub webhook 密钥)
WEBHOOK_SECRET=your-webhook-secret

# REDIS_URL (任务队列)
REDIS_URL=redis://localhost:6379

# MYSQL_URL (可选，审计日志持久化)
MYSQL_URL=mysql://user:pass@localhost:3306/healing

# 运行环境
NODE_ENV=development

# 服务端口
PORT=8787
